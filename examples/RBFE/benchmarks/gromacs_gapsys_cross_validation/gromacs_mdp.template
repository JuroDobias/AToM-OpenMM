; GROMACS Gapsys fixed-coordinate validation
integrator               = md
dt                       = 0.001
nsteps                   = 0
continuation             = no
constraints              = none
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
rvdw                     = 1.0
vdw-modifier             = none
DispCorr                  = no
pbc                      = xyz
fourierspacing           = 0.12
ewald-rtol               = 1e-5
free-energy              = yes
init-lambda              = @LAMBDA@
delta-lambda             = 0
couple-moltype           = MTH
couple-lambda0           = vdw-q
couple-lambda1           = none
couple-intramol          = no
sc-function              = gapsys
sc-alpha                 = 0.5
sc-gapsys-scale-linpoint-lj = 0.85
sc-gapsys-scale-linpoint-q  = 0.30
sc-gapsys-sigma-lj          = 0.30
nstcalcenergy            = 1
nstenergy                = 1
nstdhdl                  = 1
dhdl-derivatives         = yes
separate-dhdl-file       = yes
dhdl-print-energy        = potential
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1
